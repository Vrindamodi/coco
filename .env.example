# PostgreSQL
POSTGRES_USER=coco
POSTGRES_PASSWORD=coco_dev_password
POSTGRES_DB=coco
DATABASE_URL=postgresql://coco:coco_dev_password@localhost:5433/coco

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=change-me-to-a-random-secret-in-production
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Next.js dashboards
NEXT_PUBLIC_API_URL=http://localhost:8000

# Expo mobile
# iOS Simulator / web: localhost is fine.
# Android emulator: localhost is the emulator, not your PC. Use 10.0.2.2
# (the app also rewrites localhost automatically on Android).
# Physical device: use this computer's LAN IP, e.g. http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Cloudinary (My World media uploads)
# Leave blank to run without uploads - the dashboard falls back to pasting a URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=coco/my-world

# Groq AI (voice chatbot)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
